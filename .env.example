# 复制为 .env 后填写真实值。.env 已加入 .gitignore，绝不提交。
# 注意：DATABASE_URL 中的密码需与 POSTGRES_PASSWORD 一致（URL 编码特殊字符）。

# PostgreSQL 密码（db 服务初始化用）
POSTGRES_PASSWORD=请填写强密码

# 应用连接串（本机原生运行 / merger 用；Docker 内服务由 compose 自动拼接）
DATABASE_URL=postgresql://stockapp:请填写强密码@localhost:5432/stocks

# GitHub 发布用（周导出任务上传 Release 附件；不填则只本地导出）
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Tushare Pro（前端「数据更新」与回填脚本必需；不填则同步任务会直接失败）
TUSHARE_TOKEN=
# 可选：中转站地址（如 https://teajoin.com）；直连官方则留空
# TUSHARE_BASE_URL=

# 时区
TZ=Asia/Shanghai

# 拉取并发线程数（可选）
FETCH_WORKERS=8

# ---------------- 登录认证 ----------------
# JWT 签名密钥（生产环境必须设置足够长的随机串；不填则每次启动随机生成，重启后需重新登录）
# JWT_SECRET=<redacted>
# 初始管理员（users 表为空时自动创建；创建后可删除这两行）
# ADMIN_USER=<redacted>
# ADMIN_PASSWORD=<redacted>
# Google OAuth（Google Cloud Console → API 和服务 → 凭据 → OAuth 客户端 ID）
# 回调地址填：http(s)://你的域名/api/auth/google/callback
# GOOGLE_CLIENT_ID=<redacted>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<redacted>
